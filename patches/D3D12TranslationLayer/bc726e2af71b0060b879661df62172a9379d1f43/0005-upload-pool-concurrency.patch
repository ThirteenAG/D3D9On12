+    // The caller can defer allocation until its outer container lock is released.
+    std::optional<TResourceType> TryRetrieveFromPool(UINT64 CurrentFenceValue)
+    {
+        auto lock = m_pLock ? std::unique_lock(*m_pLock) : std::unique_lock<std::mutex>();
+        auto Head = m_Pool.begin();
+        if (Head == m_Pool.end() || CurrentFenceValue < Head->first) return std::nullopt;
+        assert(Head->second);
+        TResourceType result = std::move(Head->second);
+        m_Pool.erase(Head);
+        return std::move(result);
     }
 
