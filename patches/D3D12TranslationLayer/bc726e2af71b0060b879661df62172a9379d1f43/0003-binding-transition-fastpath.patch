+    bool ResourceStateManager::IsBindingTransitionRedundant(Resource* pResource, D3D12_RESOURCE_STATES Desired) const noexcept
+    {
+        // A pending request must keep going through the list so it can be replaced/cancelled.
+        if (pResource->IsTransitionPending())
+        {
+            return false;
+        }
+        // Fully unbound: the request would be recorded as UNKNOWN and dropped unprocessed.
+        if (Desired == UNKNOWN_RESOURCE_STATE)
+        {
+            return true;
+        }
+        if (pResource->m_bTriggersSwapchainDeferredWaits || !pResource->m_ResourceDeferredWaits.empty())
+        {
+            return false;
+        }
+        auto& Current = pResource->GetIdentity()->m_currentState;
+        if (Current.SupportsSimultaneousAccess() || !Current.AreAllSubresourcesSame() || !Current.IsExclusiveState(0))
+        {
+            return false;
+        }
+        auto const& Exclusive = Current.GetExclusiveSubresourceState(0);
+        if (Exclusive.CommandListType != COMMAND_LIST_TYPE::GRAPHICS ||
+            (Exclusive.State & Desired) != Desired)
+        {
+            return false;
+        }
+        // Same command list as the last accounted use: fence, residency set and
+        // used-in-command-list bookkeeping are already up to date. Both the state
+        // fence and the resource's own last-used ID must match (some paths update
+        // the state fence without going through UsedInCommandList).
+        CommandListManager* pManager = m_ImmCtx.GetCommandListManager(COMMAND_LIST_TYPE::GRAPHICS);
+        if (!pManager)
+        {
+            return false;
+        }
+        const UINT64 CurrentID = pManager->GetCommandListID();
+        return Exclusive.FenceValue == CurrentID &&
+            pResource->m_LastUsedCommandListID[(UINT)COMMAND_LIST_TYPE::GRAPHICS] == CurrentID;
+    }
+#endif
