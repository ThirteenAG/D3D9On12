include_guard(GLOBAL)
include(CMakeParseArguments)
set(_D3D9ON12_TL_PATCH_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/../patches/D3D12TranslationLayer/bc726e2af71b0060b879661df62172a9379d1f43")

function(_d3d9on12_tl_entry entry out_path out_lf out_crlf)
    string(REPLACE "|" ";" fields "${entry}")
    list(LENGTH fields field_count)
    if(NOT field_count EQUAL 3)
        message(FATAL_ERROR "Invalid TL manifest record: ${entry}")
    endif()
    list(GET fields 0 path)
    if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Invalid relative TL manifest path: ${path}")
    endif()
    list(GET fields 1 lf)
    list(GET fields 2 crlf)
    set(${out_path} "${path}" PARENT_SCOPE)
    set(${out_lf} "${lf}" PARENT_SCOPE)
    set(${out_crlf} "${crlf}" PARENT_SCOPE)
endfunction()

function(_d3d9on12_tl_write_lf path text template)
    # Native file(WRITE) converts LF to CRLF on Windows. A CR before a patch's
    # "No newline at end of file" marker becomes part of the expected last line.
    # Write canonical LF literally while preserving a missing final newline.
    string(FIND "${text}" "\n" last_newline REVERSE)
    if(last_newline EQUAL -1)
        file(WRITE "${path}" "${text}")
    else()
        string(SUBSTRING "${text}" 0 ${last_newline} D3D9ON12_TL_LITERAL)
        configure_file("${template}" "${path}" @ONLY NEWLINE_STYLE UNIX)
        math(EXPR suffix_start "${last_newline} + 1")
        string(SUBSTRING "${text}" ${suffix_start} -1 suffix)
        file(APPEND "${path}" "${suffix}")
    endif()
endfunction()

function(_d3d9on12_tl_verify)
    cmake_parse_arguments(VERIFY "ALLOW_CRLF;EXACT_FILE_LIST" "SOURCE" "ENTRIES" ${ARGN})
    set(expected_paths)
    foreach(entry IN LISTS VERIFY_ENTRIES)
        _d3d9on12_tl_entry("${entry}" path lf crlf)
        set(file "${VERIFY_SOURCE}/${path}")
        if(NOT EXISTS "${file}" OR IS_DIRECTORY "${file}" OR IS_SYMLINK "${file}")
            message(FATAL_ERROR "Missing or nonregular TL input: ${file}")
        endif()
        file(SHA256 "${file}" actual)
        string(TOUPPER "${actual}" actual)
        if(NOT actual STREQUAL lf AND NOT (VERIFY_ALLOW_CRLF AND actual STREQUAL crlf))
            message(FATAL_ERROR "TL identity mismatch: ${file}\nExpected LF ${lf}\nExpected CRLF ${crlf}\nActual ${actual}\nUse the clean pinned input, or an exact selected tree with VERIFY_PREPATCHED.")
        endif()
        list(APPEND expected_paths "${path}")
    endforeach()
    if(VERIFY_EXACT_FILE_LIST)
        file(GLOB_RECURSE actual_paths RELATIVE "${VERIFY_SOURCE}" LIST_DIRECTORIES true "${VERIFY_SOURCE}/*")
        set(actual_files)
        foreach(path IN LISTS actual_paths)
            if(path MATCHES "^\\.git(/|$)")
                continue()
            endif()
            if(IS_SYMLINK "${VERIFY_SOURCE}/${path}")
                message(FATAL_ERROR "Unexpected symlink in verified TL source: ${path}")
            endif()
            if(NOT IS_DIRECTORY "${VERIFY_SOURCE}/${path}")
                list(APPEND actual_files "${path}")
            endif()
        endforeach()
        list(SORT actual_files)
        list(SORT expected_paths)
        if(NOT actual_files STREQUAL expected_paths)
            message(FATAL_ERROR "Unexpected file list in verified TL source: ${VERIFY_SOURCE}")
        endif()
    endif()
endfunction()

function(d3d9on12_prepare_translation_layer)
    cmake_parse_arguments(PREPARE "" "INPUT;OUTPUT;POLICY;OUT_SOURCE;OUT_SIGNATURE" "PATCHES" ${ARGN})
    if(NOT PREPARE_OUT_SOURCE OR NOT PREPARE_OUT_SIGNATURE)
        message(FATAL_ERROR "TL preparation requires OUT_SOURCE and OUT_SIGNATURE result variables")
    endif()
    if(NOT PREPARE_INPUT OR NOT IS_DIRECTORY "${PREPARE_INPUT}")
        message(FATAL_ERROR "TL INPUT must name an existing source directory")
    endif()
    if(NOT PREPARE_POLICY MATCHES "^(STAGE|VERIFY_PREPATCHED)$")
        message(FATAL_ERROR "TL source policy must be STAGE or VERIFY_PREPATCHED")
    endif()
    include("${_D3D9ON12_TL_PATCH_DIRECTORY}/manifest.cmake")
    file(READ "${_D3D9ON12_TL_PATCH_DIRECTORY}/manifest.cmake" manifest_text)
    string(REPLACE "\r\n" "\n" manifest_text "${manifest_text}")
    string(SHA256 manifest_hash "${manifest_text}")
    set(signature_text "tl-stage-v2\nbase=${D3D9ON12_TL_BASE_COMMIT}\nmanifest=${manifest_hash}\n")
    set(expected "${D3D9ON12_TL_BASE_FILES}")
    set(selected)
    foreach(id IN LISTS PREPARE_PATCHES)
        if(NOT id MATCHES "^(legacy-present|batch-worker-flush|binding-transition-fastpath|per-draw-state|upload-pool-concurrency|shared-upload-chunks|pooled-buffer-updates|gpu-upload-buffers)$")
            message(FATAL_ERROR "Unknown TL patch ID: ${id}")
        endif()
    endforeach()
    if("per-draw-state" IN_LIST PREPARE_PATCHES)
        foreach(required IN ITEMS batch-worker-flush binding-transition-fastpath)
            if(NOT required IN_LIST PREPARE_PATCHES)
                message(FATAL_ERROR "per-draw-state requires textual prerequisite ${required}")
            endif()
        endforeach()
    endif()
    if("upload-pool-concurrency" IN_LIST PREPARE_PATCHES AND NOT "per-draw-state" IN_LIST PREPARE_PATCHES)
        message(FATAL_ERROR "upload-pool-concurrency requires textual prerequisite per-draw-state")
    endif()
    if("shared-upload-chunks" IN_LIST PREPARE_PATCHES AND NOT "upload-pool-concurrency" IN_LIST PREPARE_PATCHES)
        message(FATAL_ERROR "shared-upload-chunks requires textual prerequisite upload-pool-concurrency")
    endif()
    if("pooled-buffer-updates" IN_LIST PREPARE_PATCHES AND NOT "shared-upload-chunks" IN_LIST PREPARE_PATCHES)
        message(FATAL_ERROR "pooled-buffer-updates requires textual prerequisite shared-upload-chunks")
    endif()
    if("gpu-upload-buffers" IN_LIST PREPARE_PATCHES AND NOT "pooled-buffer-updates" IN_LIST PREPARE_PATCHES)
        message(FATAL_ERROR "gpu-upload-buffers requires textual prerequisite pooled-buffer-updates")
    endif()
    # Canonical order is independent of the order supplied by a manual caller.
    foreach(id IN ITEMS legacy-present batch-worker-flush binding-transition-fastpath per-draw-state upload-pool-concurrency shared-upload-chunks pooled-buffer-updates gpu-upload-buffers)
        if(NOT id IN_LIST PREPARE_PATCHES)
            continue()
        endif()
        string(REPLACE "-" "_" key "${id}")
        string(TOUPPER "${key}" key)
        set(prefix "D3D9ON12_TL_${key}")
        set(patch "${_D3D9ON12_TL_PATCH_DIRECTORY}/${${prefix}_PATCH}")
        file(READ "${patch}" patch_text)
        string(REPLACE "\r\n" "\n" patch_text "${patch_text}")
        string(SHA256 patch_hash "${patch_text}")
        string(TOUPPER "${patch_hash}" patch_hash)
        if(NOT patch_hash STREQUAL "${${prefix}_PATCH_SHA256}")
            message(FATAL_ERROR "TL patch hash mismatch: ${patch}")
        endif()
        set(patch_text_${key} "${patch_text}")
        list(APPEND selected "${id}")
        string(APPEND signature_text "patch=${id}:${patch_hash}\n")
        foreach(post IN LISTS ${prefix}_POST_IMAGES)
            _d3d9on12_tl_entry("${post}" post_path post_lf post_crlf)
            set(next_expected)
            foreach(entry IN LISTS expected)
                _d3d9on12_tl_entry("${entry}" path lf crlf)
                if(NOT path STREQUAL post_path)
                    list(APPEND next_expected "${entry}")
                endif()
            endforeach()
            set(expected "${next_expected}")
            list(APPEND expected "${post}")
        endforeach()
    endforeach()
    string(SHA256 signature "${signature_text}")
    get_filename_component(input "${PREPARE_INPUT}" REALPATH)
    if(PREPARE_POLICY STREQUAL "VERIFY_PREPATCHED")
        _d3d9on12_tl_verify(SOURCE "${input}" ENTRIES ${expected} ALLOW_CRLF EXACT_FILE_LIST)
        set(${PREPARE_OUT_SOURCE} "${input}" PARENT_SCOPE)
        set(${PREPARE_OUT_SIGNATURE} "${signature}" PARENT_SCOPE)
        return()
    endif()
    _d3d9on12_tl_verify(SOURCE "${input}" ENTRIES ${D3D9ON12_TL_BASE_FILES} ALLOW_CRLF)
    if(NOT PREPARE_OUTPUT)
        message(FATAL_ERROR "TL STAGE requires an explicit private OUTPUT directory")
    endif()
    # A short directory name avoids long VS paths; full identity is checked below.
    string(SUBSTRING "${signature}" 0 16 short_signature)
    string(REPLACE "@SIGNATURE@" "${short_signature}" output "${PREPARE_OUTPUT}")
    get_filename_component(output "${output}" ABSOLUTE)
    # Resolve an existing ancestor before writing, including junction/symlink paths.
    set(ancestor "${output}")
    set(suffix)
    while(NOT EXISTS "${ancestor}")
        get_filename_component(name "${ancestor}" NAME)
        get_filename_component(next "${ancestor}" DIRECTORY)
        if(next STREQUAL ancestor)
            message(FATAL_ERROR "Cannot resolve private TL output: ${output}")
        endif()
        set(suffix "${name}/${suffix}")
        set(ancestor "${next}")
    endwhile()
    get_filename_component(ancestor "${ancestor}" REALPATH)
    get_filename_component(output "${ancestor}/${suffix}" ABSOLUTE)
    set(input_compare "${input}/")
    set(output_compare "${output}/")
    if(WIN32)
        string(TOLOWER "${input_compare}" input_compare)
        string(TOLOWER "${output_compare}" output_compare)
    endif()
    string(FIND "${input_compare}" "${output_compare}" input_in_output)
    string(FIND "${output_compare}" "${input_compare}" output_in_input)
    if(input_in_output EQUAL 0 OR output_in_input EQUAL 0)
        message(FATAL_ERROR "TL stage OUTPUT and INPUT must be disjoint: ${output} / ${input}")
    endif()
    get_filename_component(parent "${output}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(LOCK "${output}.lock" GUARD FUNCTION TIMEOUT 30 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Cannot lock private TL stage: ${lock_result}")
    endif()
    set(identity "${signature_text}signature=${signature}\n")
    if(EXISTS "${output}")
        if(NOT EXISTS "${output}/identity.txt")
            message(FATAL_ERROR "Incomplete private TL stage preserved for inspection: ${output}")
        endif()
        file(READ "${output}/identity.txt" existing_identity)
        if(NOT existing_identity STREQUAL identity)
            message(FATAL_ERROR "Private TL stage identity differs: ${output}")
        endif()
        _d3d9on12_tl_verify(SOURCE "${output}/source" ENTRIES ${expected} ALLOW_CRLF EXACT_FILE_LIST)
    else()
        find_package(Git REQUIRED)
        string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
        set(temporary "${output}.preparing-${nonce}")
        file(MAKE_DIRECTORY "${temporary}/source" "${temporary}/patches")
        file(WRITE "${temporary}/literal.in" "@D3D9ON12_TL_LITERAL@")
        foreach(entry IN LISTS D3D9ON12_TL_BASE_FILES)
            _d3d9on12_tl_entry("${entry}" path lf crlf)
            file(READ "${input}/${path}" text)
            string(REPLACE "\r\n" "\n" text "${text}")
            get_filename_component(directory "${temporary}/source/${path}" DIRECTORY)
            file(MAKE_DIRECTORY "${directory}")
            _d3d9on12_tl_write_lf("${temporary}/source/${path}" "${text}" "${temporary}/literal.in")
        endforeach()
        _d3d9on12_tl_verify(SOURCE "${temporary}/source" ENTRIES ${D3D9ON12_TL_BASE_FILES} ALLOW_CRLF EXACT_FILE_LIST)
        foreach(id IN LISTS selected)
            string(REPLACE "-" "_" key "${id}")
            string(TOUPPER "${key}" key)
            set(prefix "D3D9ON12_TL_${key}")
            set(patch "${temporary}/patches/${${prefix}_PATCH}")
            _d3d9on12_tl_write_lf("${patch}" "${patch_text_${key}}" "${temporary}/literal.in")
            # Do not inherit an enclosing project's repository or Git index;
            # git apply must operate relative to this private source directory.
            execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
                "GIT_CEILING_DIRECTORIES=${temporary}" "${GIT_EXECUTABLE}" -c core.autocrlf=false -c core.safecrlf=false apply --check --whitespace=nowarn "${patch}"
                WORKING_DIRECTORY "${temporary}/source" RESULT_VARIABLE result ERROR_VARIABLE error)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "TL patch check failed: ${id}\n${error}\nPrivate temporary stage: ${temporary}")
            endif()
            execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
                "GIT_CEILING_DIRECTORIES=${temporary}" "${GIT_EXECUTABLE}" -c core.autocrlf=false -c core.safecrlf=false apply --whitespace=nowarn "${patch}"
                WORKING_DIRECTORY "${temporary}/source" RESULT_VARIABLE result ERROR_VARIABLE error)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "TL patch apply failed: ${id}\n${error}\nPrivate temporary stage: ${temporary}")
            endif()
        endforeach()
        _d3d9on12_tl_verify(SOURCE "${temporary}/source" ENTRIES ${expected} ALLOW_CRLF EXACT_FILE_LIST)
        file(WRITE "${temporary}/identity.txt" "${identity}")
        file(RENAME "${temporary}" "${output}")
    endif()
    set(${PREPARE_OUT_SOURCE} "${output}/source" PARENT_SCOPE)
    set(${PREPARE_OUT_SIGNATURE} "${signature}" PARENT_SCOPE)
endfunction()

# The same verified preparation is available explicitly without configuring a project.
if(DEFINED CMAKE_SCRIPT_MODE_FILE AND "${CMAKE_SCRIPT_MODE_FILE}" STREQUAL "${CMAKE_CURRENT_LIST_FILE}")
    if(NOT DEFINED D3D9ON12_TL_POLICY)
        set(D3D9ON12_TL_POLICY STAGE)
    endif()
    d3d9on12_prepare_translation_layer(INPUT "${D3D9ON12_TL_INPUT}" OUTPUT "${D3D9ON12_TL_OUTPUT}"
        POLICY "${D3D9ON12_TL_POLICY}" PATCHES ${D3D9ON12_TL_PATCHES} OUT_SOURCE source OUT_SIGNATURE signature)
    message(STATUS "Prepared TL source: ${source}")
    message(STATUS "TL patch signature: ${signature}")
endif()
