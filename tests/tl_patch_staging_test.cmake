# file(WRITE) uses native newlines on Windows. A one-token template writes LF
# literally; append the final non-newline suffix to preserve missing final EOLs.
file(WRITE "${work}/literal.in" "@TL_TEST_LITERAL@")
function(write_lf path text)
    string(FIND "${text}" "\n" last_newline REVERSE)
    if(last_newline EQUAL -1)
        file(WRITE "${path}" "${text}")
    else()
        string(SUBSTRING "${text}" 0 ${last_newline} TL_TEST_LITERAL)
        configure_file("${work}/literal.in" "${path}" @ONLY NEWLINE_STYLE UNIX)
        math(EXPR suffix_start "${last_newline} + 1")
        string(SUBSTRING "${text}" ${suffix_start} -1 suffix)
        file(APPEND "${path}" "${suffix}")
    endif()
endfunction()

function(copy_fixture destination line_endings)
    foreach(entry IN LISTS D3D9ON12_TL_BASE_FILES)
        _d3d9on12_tl_entry("${entry}" path lf crlf)
        file(READ "${input}/${path}" text)
        string(REPLACE "\r\n" "\n" text "${text}")
        get_filename_component(directory "${destination}/${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
        if(line_endings STREQUAL "LF")
            write_lf("${destination}/${path}" "${text}")
        else()
            if(NOT WIN32)
                string(REPLACE "\n" "\r\n" text "${text}")
            endif()
            file(WRITE "${destination}/${path}" "${text}")
        endif()
    endforeach()
endfunction()

function(expect_failure name case_input case_output policy patches pattern)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DD3D9ON12_TL_INPUT=${case_input}"
        "-DD3D9ON12_TL_OUTPUT=${case_output}" "-DD3D9ON12_TL_POLICY=${policy}"
        "-DD3D9ON12_TL_PATCHES=${patches}" -P "${helper}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${work}/${name}.log" "${output}${error}")
    if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Negative TL case failed: ${name}\n${output}${error}")
    endif()
endfunction()

